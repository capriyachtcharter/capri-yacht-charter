# claude code
.claude/

# Full-res originals of every photo/video the site uses, kept in the project
# as local reference (source-materials/originali, mirroring public/ with the
# same names). NOT committed: ~150MB of stills + a video would bloat the repo
# and exceed GitHub's 100MB limit. The site only serves the resized public/ copies.
/source-materials/originali/

# User's master archive folder (3.1 GB of stills + MP4 video). Trailing space
# in folder name is intentional — match with wildcard so the space doesn't
# get stripped by gitignore. NEVER commit: would blow GitHub's 100MB file
# limit and bloat history.
/foto capri*/
.vercel

# Netlify local build output
.netlify/
deno.lock
